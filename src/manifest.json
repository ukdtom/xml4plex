{
  "manifest_version": 3,
  "name": "XML4Plex",
  "version": "0.0.9",
  "description": "Show XML for a shared Plex Media Server",
  "content_scripts": [
    {
      "matches": ["https://app.plex.tv/desktop/*"],
      "js": ["contents/contentScript.js"],
      "css": ["contents/contentScript.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [ "assets/xml.png", "assets/down-arrow.png", "assets/json.png" ],
      "matches": [ "https://app.plex.tv/*", "<all_urls>" ]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/queue.html"
  },
  "options_page": "options/options.html",
  "permissions" : [
    "tabs",
    "downloads",
    "storage",
    "cookies",
    "offscreen"
  ],
  "icons": {
    "64": "assets/xml.png"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  }
}