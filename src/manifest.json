{
  "manifest_version": 3,
  "name": "XML4Plex",
  "version": "0.0.7",
  "description": "Show XML for a shared Plex Media Server",
  "content_scripts": [
    {
      "matches": ["https://app.plex.tv/*"],
      "js": ["contents/contentScript.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "/assets/xml.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/queue.html"
  },
  "permissions" : [
    "tabs",
    "downloads",
    "downloads.ui",
    "activeTab",
    "storage",
    "cookies"
  ],
  "icons": {
    "64": "assets/xml.png"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  }
}