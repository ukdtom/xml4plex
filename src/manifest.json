{
  "manifest_version": 3,
  "name": "XML4Plex",
  "version": "0.0.8",
  "description": "Show XML for a shared Plex Media Server",
  "content_scripts": [
    {
      "matches": ["https://app.plex.tv/*"],
      "js": ["contents/contentScript.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "/assets/xml.png"
      ],
      "matches": ["https://app.plex.tv/*"]
    }
  ],
  "host_permissions": [
    "https://app.plex.tv/*"
  ],
  "action": {
    "default_popup": "popup/queue.html"
  },
  "options_page": "options/options.html",
  "permissions" : [
    "tabs",
    "downloads",
    "storage",
    "cookies"
  ],
  "icons": {
    "64": "assets/xml.png"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  }
}